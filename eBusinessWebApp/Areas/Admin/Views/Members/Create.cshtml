@using eBusinessWebApp.ViewModels.TeamVM

@model MemberVM
<div class="row d-flex justify-content-center">
    <form method="post" class="col-5">
        <div class="form-group">
            <label asp-for="Name">Name</label>
            <input asp-for="Name" class="form-control" id="name" placeholder="Enter Name">
            <span asp-validation-for="Name"></span>
        </div>
        <div class="form-group">
            <label asp-for="Surname">Surname</label>
            <input asp-for="Surname" class="form-control" id="surname" placeholder="Enter Surname">
            <span asp-validation-for="Surname"></span>
        </div>
        <div class="form-group">
            <label asp-for="Position">Job</label>
            <input asp-for="Position" class="form-control" id="job" placeholder="Enter Job">
            <span asp-validation-for="Position"></span>
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>